# Neon: copie as duas strings em Console > Connect.
# Conexão com pooler (host com "-pooler"): usada pela API.
DATABASE_URL="postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/imperio?sslmode=require"
# Conexão direta (sem "-pooler"): usada pelas migrations do drizzle-kit.
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/imperio?sslmode=require"

JWT_SECRET="troque-por-um-segredo-longo"
WEB_ORIGIN="http://localhost:5173"
PORT=3000

# Só para o Postgres local do docker-compose (deixe comentado quando usar o Neon):
# DATABASE_URL="postgresql://imperio:imperio@localhost:5432/imperio"
# DATABASE_URL_UNPOOLED="postgresql://imperio:imperio@localhost:5432/imperio"
# NEON_LOCAL_PROXY="localhost:5433"
